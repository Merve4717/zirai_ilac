@{
    ViewData["Title"] = "Ana Sayfa - Dashboard";
}

<div class="row g-4 mb-4">
    <!-- METRİKLER -->
    <div class="col-md-3">
        <div class="premium-card">
            <div class="premium-card-title">📦 Ürün Çeşidi</div>
            <div class="premium-card-value">@ViewBag.TotalProducts</div>
            <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 8px;">Kayıtlı farklı formül / ürün</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="premium-card">
            <div class="premium-card-title">🌾 Toplam Stok</div>
            <div class="premium-card-value">@ViewBag.TotalStock.ToString("N0") <span style="font-size: 0.9rem; font-weight: 500;">Adet</span></div>
            <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 8px;">Depodaki toplam envanter</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="premium-card">
            <div class="premium-card-title">👥 Müşteriler</div>
            <div class="premium-card-value">@ViewBag.TotalCustomers</div>
            <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 8px;">Kayıtlı üretici ve bayiler</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="premium-card">
            <div class="premium-card-title">💰 Toplam Satış</div>
            <div class="premium-card-value" style="color: var(--accent-emerald);">@ViewBag.TotalRevenue.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</div>
            <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 8px;">Faturalandırılmış sipariş tutarı</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- SOL KOLON: Son Siparişler ve Kategori Dağılımı -->
    <div class="col-lg-8">
        <!-- Son Siparişler -->
        <div class="premium-card p-0" style="overflow: hidden;">
            <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between;">
                <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin: 0;">📋 Son Siparişler</h4>
                <a asp-controller="Order" asp-action="Index" class="btn-premium btn-premium-secondary btn-premium-sm" style="font-size: 0.78rem;">Tümünü Gör</a>
            </div>
            
            <div class="table-responsive">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>Sipariş No</th>
                            <th>Müşteri</th>
                            <th>Tarih</th>
                            <th>Tutar</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentOrders != null && ((List<ZiraiIlacERPWeb.Models.Order>)ViewBag.RecentOrders).Count > 0)
                        {
                            foreach (var order in (List<ZiraiIlacERPWeb.Models.Order>)ViewBag.RecentOrders)
                            {
                                <tr>
                                    <td style="font-weight: 700; color: var(--accent-emerald);">#@order.Id</td>
                                    <td>@(order.Customer?.FullName ?? "Bilinmeyen Müşteri")</td>
                                    <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td style="font-weight: 600; color: var(--text-primary);">
                                        @(order.TotalAmount?.ToString("C2", new System.Globalization.CultureInfo("tr-TR")) ?? "0.00 ₺")
                                    </td>
                                    <td>
                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn-premium btn-premium-gold btn-premium-sm">Detay</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align: center; color: var(--text-secondary); padding: 30px;">Kayıtlı sipariş bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Kategori Dağılımı -->
        <div class="premium-card mt-4">
            <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 20px;">📂 Kategori Bazlı Envanter Dağılımı</h4>
            <div class="row g-3">
                @if (ViewBag.CategoryStats != null)
                {
                    foreach (var stat in ViewBag.CategoryStats)
                    {
                        <div class="col-md-6">
                            <div style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 10px; padding: 16px; display: flex; align-items: center; justify-content: space-between;">
                                <div>
                                    <div style="font-weight: 700; color: var(--text-primary); font-size: 0.95rem;">@stat.CategoryName</div>
                                    <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">@stat.ProductCount Ürün Çeşidi</div>
                                </div>
                                <div style="text-align: right;">
                                    <span class="zirai-badge zirai-badge-emerald">@stat.TotalStock.ToString("N0") Adet</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- SAĞ KOLON: Kritik Stok Uyarısı -->
    <div class="col-lg-4">
        <div class="premium-card" style="border-color: rgba(239, 68, 68, 0.3); background: radial-gradient(circle at bottom, rgba(239, 68, 68, 0.03), var(--card-bg));">
            <h4 style="font-size: 1.1rem; font-weight: 700; color: #f87171; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                ⚠️ Kritik Stok Uyarısı
            </h4>
            
            <div style="display: flex; flex-direction: column; gap: 12px;">
                @if (ViewBag.CriticalStock != null && ((List<ZiraiIlacERPWeb.Models.Product>)ViewBag.CriticalStock).Count > 0)
                {
                    foreach (var product in (List<ZiraiIlacERPWeb.Models.Product>)ViewBag.CriticalStock)
                    {
                        <div style="background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.15); border-radius: 10px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between;">
                            <div>
                                <div style="font-weight: 600; font-size: 0.88rem; color: var(--text-primary);">@product.ProductName</div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 2px;">Kat: @(product.Category?.CategoryName ?? "Belirtilmemiş")</div>
                            </div>
                            <div style="text-align: right;">
                                <span class="zirai-badge zirai-badge-danger">@product.StockQuantity Adet</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 40px 0; color: var(--text-secondary); font-size: 0.85rem;">
                        Depoda kritik stok seviyesinde (30 adedin altında) ürün bulunmamaktadır.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
