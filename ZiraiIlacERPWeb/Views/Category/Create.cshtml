@model ZiraiIlacERPWeb.Models.Category

@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<div style="max-width: 500px; margin: 0 auto;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 style="font-weight: 700; color: var(--text-primary); margin: 0;">➕ Yeni Kategori Ekle</h2>
        <a asp-action="Index" class="btn-premium btn-premium-secondary btn-premium-sm">Geri Dön</a>
    </div>

    <div class="premium-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="CategoryName" class="premium-form-label">Kategori Adı *</label>
                <input asp-for="CategoryName" class="form-control premium-input" placeholder="Örn: Yaprak Gübreleri" required />
                <span asp-validation-for="CategoryName" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <button type="submit" class="btn-premium btn-premium-emerald w-100 justify-content-center">💾 Kaydet</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
