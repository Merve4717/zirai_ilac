@model List<ZiraiIlacERPWeb.Models.Product>

@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 style="font-weight: 700; color: var(--text-primary); margin: 0;">📦 Zirai İlaç & Ürün Listesi</h2>
    <a asp-action="Create" class="btn-premium btn-premium-emerald">➕ Yeni Ürün Ekle</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="premium-card">
            <div class="premium-card-title">Toplam Ürün Çeşidi</div>
            <div class="premium-card-value">@Model.Count</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="premium-card">
            <div class="premium-card-title">Toplam Stok Miktarı</div>
            <div class="premium-card-value" style="color: var(--accent-emerald);">@Model.Sum(x => x.StockQuantity).ToString("N0") <span style="font-size: 0.9rem; font-weight: 500;">Adet</span></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="premium-card">
            <div class="premium-card-title">Kritik Stoktaki Ürünler</div>
            <div class="premium-card-value" style="color: #ef4444;">@Model.Count(x => x.StockQuantity <= 30)</div>
        </div>
    </div>
</div>

<div class="premium-table-container">
    <table class="premium-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Ürün Adı</th>
                <th>Kategori</th>
                <th>Barkod</th>
                <th>Fiyat</th>
                <th>Stok</th>
                <th>Son Kullanma T.</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight: 700; color: var(--accent-emerald);">#@item.Id</td>
                    <td style="font-weight: 600; color: var(--text-primary);">@item.ProductName</td>
                    <td>
                        <span class="zirai-badge zirai-badge-emerald">@(item.Category?.CategoryName ?? "Belirtilmemiş")</span>
                    </td>
                    <td><code>@item.Barcode</code></td>
                    <td style="font-weight: 600;">@item.Price.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</td>
                    <td>
                        @if (item.StockQuantity <= 30)
                        {
                            <span class="zirai-badge zirai-badge-danger">@item.StockQuantity Adet (Kritik)</span>
                        }
                        else
                        {
                            <span class="zirai-badge zirai-badge-emerald" style="background: rgba(16, 185, 129, 0.08);">@item.StockQuantity Adet</span>
                        }
                    </td>
                    <td>
                        @(item.ExpirationDate?.ToString("dd.MM.yyyy") ?? "—")
                    </td>
                    <td>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Bu ürünü silmek istediğinize emin misiniz?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn-premium btn-premium-danger btn-premium-sm">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
