@model List<ZiraiIlacERPWeb.Models.Product>

<div class="container mt-4">

    <h1 class="text-center mb-4">
        Zirai İlaç ERP Sistemi
    </h1>

    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5>Toplam Ürün</h5>
                    <h2>@Model.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5>Toplam Stok</h5>
                    <h2>@Model.Sum(x => x.StockQuantity)</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-dark bg-warning">
                <div class="card-body">
                    <h5>Ürün Çeşidi</h5>
                    <h2>@Model.Count</h2>
                </div>
            </div>
        </div>

    </div>

    <a asp-action="Create" class="btn btn-success mb-3">
        Yeni Ürün Ekle
    </a>

    <table class="table table-striped table-hover table-bordered">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Ürün Adı</th>
                <th>Barkod</th>
                <th>Fiyat</th>
                <th>Stok</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.ProductName</td>
                    <td>@item.Barcode</td>
                    <td>@item.Price ₺</td>
                    <td>@item.StockQuantity</td>

                    <td>
                        <form asp-action="Delete" method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Sil
                            </button>

                        </form>
                    </td>

                </tr>
            }
        </tbody>

    </table>

</div>



