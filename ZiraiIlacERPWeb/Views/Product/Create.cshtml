@model ZiraiIlacERPWeb.Models.Product

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<div style="max-width: 600px; margin: 0 auto;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 style="font-weight: 700; color: var(--text-primary); margin: 0;">➕ Yeni Ürün Ekle</h2>
        <a asp-action="Index" class="btn-premium btn-premium-secondary btn-premium-sm">Geri Dön</a>
    </div>

    <div class="premium-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ProductName" class="premium-form-label">Ürün Adı *</label>
                <input asp-for="ProductName" class="form-control premium-input" placeholder="Örn: Süper Böcek İlacı 1L" required />
                <span asp-validation-for="ProductName" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="premium-form-label">Kategori *</label>
                <select asp-for="CategoryId" class="form-control premium-input" asp-items="ViewBag.Categories" required>
                    <option value="">-- Kategori Seçin --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Barcode" class="premium-form-label">Barkod</label>
                <input asp-for="Barcode" class="form-control premium-input" placeholder="Örn: 8691234567890" />
                <span asp-validation-for="Barcode" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="premium-form-label">Fiyat (₺) *</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control premium-input" placeholder="0.00" required />
                    <span asp-validation-for="Price" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="StockQuantity" class="premium-form-label">Stok Miktarı *</label>
                    <input asp-for="StockQuantity" type="number" class="form-control premium-input" placeholder="0" required />
                    <span asp-validation-for="StockQuantity" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ExpirationDate" class="premium-form-label">Son Kullanma Tarihi</label>
                <input asp-for="ExpirationDate" type="date" class="form-control premium-input" />
                <span asp-validation-for="ExpirationDate" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn-premium btn-premium-emerald w-100 justify-content-center">💾 Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
