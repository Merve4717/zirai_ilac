@model List<ZiraiIlacERPWeb.Models.Customer>

@{
    ViewData["Title"] = "Müşteriler";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 style="font-weight: 700; color: var(--text-primary); margin: 0;">👥 Müşteri & Bayi Listesi</h2>
    <a asp-action="Create" class="btn-premium btn-premium-emerald">➕ Yeni Müşteri Ekle</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="premium-card">
            <div class="premium-card-title">Toplam Kayıtlı Müşteri</div>
            <div class="premium-card-value">@Model.Count</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="premium-card">
            <div class="premium-card-title">En Çok Alışveriş Yapan</div>
            <div class="premium-card-value" style="color: var(--accent-gold);">
                @{
                    var topCust = Model.OrderByDescending(c => c.Orders?.Count ?? 0).FirstOrDefault();
                    @if (topCust != null && (topCust.Orders?.Count ?? 0) > 0)
                    {
                        <span>@topCust.FullName (@(topCust.Orders?.Count ?? 0) Sipariş)</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="premium-table-container">
    <table class="premium-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Ad Soyad</th>
                <th>Telefon</th>
                <th>E-posta</th>
                <th>Adres</th>
                <th>Sipariş Sayısı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight: 700; color: var(--accent-emerald);">#@item.Id</td>
                    <td style="font-weight: 600; color: var(--text-primary);">@item.FullName</td>
                    <td>@item.PhoneNumber</td>
                    <td><code>@item.Email</code></td>
                    <td>@item.Address</td>
                    <td>
                        <span class="zirai-badge zirai-badge-emerald">@(item.Orders?.Count ?? 0) Sipariş</span>
                    </td>
                    <td>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Bu müşteriyi silmek istediğinize emin misiniz? (Müşteriye bağlı tüm siparişler de silinecektir)');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn-premium btn-premium-danger btn-premium-sm">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
