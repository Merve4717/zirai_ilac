@model ZiraiIlacERPWeb.Models.Customer

@{
    ViewData["Title"] = "Yeni Müşteri Ekle";
}

<div style="max-width: 600px; margin: 0 auto;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 style="font-weight: 700; color: var(--text-primary); margin: 0;">➕ Yeni Müşteri Ekle</h2>
        <a asp-action="Index" class="btn-premium btn-premium-secondary btn-premium-sm">Geri Dön</a>
    </div>

    <div class="premium-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="premium-form-label">Ad *</label>
                    <input asp-for="FirstName" class="form-control premium-input" placeholder="Örn: Ahmet" required />
                    <span asp-validation-for="FirstName" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="premium-form-label">Soyad *</label>
                    <input asp-for="LastName" class="form-control premium-input" placeholder="Örn: Yılmaz" required />
                    <span asp-validation-for="LastName" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="premium-form-label">Telefon</label>
                <input asp-for="PhoneNumber" class="form-control premium-input" placeholder="Örn: 05551112233" />
                <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="premium-form-label">E-posta</label>
                <input asp-for="Email" type="email" class="form-control premium-input" placeholder="Örn: ahmet@yolcu.com" />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Address" class="premium-form-label">Adres</label>
                <textarea asp-for="Address" class="form-control premium-input" rows="3" placeholder="Örn: Merkez, Şanlıurfa"></textarea>
                <span asp-validation-for="Address" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <button type="submit" class="btn-premium btn-premium-emerald w-100 justify-content-center">💾 Kaydet</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
