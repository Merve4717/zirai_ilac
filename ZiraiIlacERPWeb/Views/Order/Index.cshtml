@model List<ZiraiIlacERPWeb.Models.Order>

@{
    ViewData["Title"] = "Siparişler";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 style="font-weight: 700; color: var(--text-primary); margin: 0;">📋 Sipariş Listesi</h2>
    <a asp-action="Create" class="btn-premium btn-premium-emerald">➕ Yeni Sipariş Oluştur</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="premium-card">
            <div class="premium-card-title">Toplam Sipariş Adedi</div>
            <div class="premium-card-value">@Model.Count</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="premium-card">
            <div class="premium-card-title">Toplam Satış Cirosu</div>
            <div class="premium-card-value" style="color: var(--accent-emerald);">@Model.Sum(x => x.TotalAmount ?? 0).ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</div>
        </div>
    </div>
</div>

<div class="premium-table-container">
    <table class="premium-table">
        <thead>
            <tr>
                <th>Sipariş No</th>
                <th>Müşteri / Bayi</th>
                <th>Sipariş Tarihi</th>
                <th>Toplam Tutar</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight: 700; color: var(--accent-emerald);">#@item.Id</td>
                    <td style="font-weight: 600; color: var(--text-primary);">@(item.Customer?.FullName ?? "Bilinmeyen Müşteri")</td>
                    <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td style="font-weight: 600; color: var(--text-primary);">
                        @(item.TotalAmount?.ToString("C2", new System.Globalization.CultureInfo("tr-TR")) ?? "0.00 ₺")
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-premium btn-premium-gold btn-premium-sm">Detay</a>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Bu siparişi silmek istediğinize emin misiniz? (Ürün stokları iade edilecektir)');" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-premium btn-premium-danger btn-premium-sm">Sil</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
