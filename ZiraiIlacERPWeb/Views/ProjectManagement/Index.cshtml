@model ZiraiIlacERPWeb.Models.ProjectDataWrapper
@{
    ViewData["Title"] = "Proje Yönetimi";
    var project = Model.Project;
    var totalTasks = Model.Tasks.Count;
    var completedTasks = Model.Tasks.Count(t => t.ProgressPercent == 100);
    var criticalTasks = Model.Tasks.Count(t => t.IsCritical);
    var projectDuration = Model.Tasks.Count > 0 ? Model.Tasks.Max(t => t.EarlyFinish) : 0;
    
    var totalIncomes = Model.Transactions.Where(t => t.Type == "Gelir").Sum(t => t.Amount);
    var totalExpenses = Model.Transactions.Where(t => t.Type == "Gider").Sum(t => t.Amount);
    var currentBalance = totalIncomes - totalExpenses;
    var budgetUsagePercent = project.Budget > 0 ? (totalExpenses / project.Budget) * 100 : 0;
}

<style>
    /* ============================================================
       MISSING UI COMPONENT STYLES (btn-db, db-glass-panel, etc.)
    ============================================================ */

    /* Container & Header */
    .db-manager-container {
        padding: 0;
    }

    .db-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border-color);
    }

    .db-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text-primary);
        margin: 0;
    }

    /* Glass Panel */
    .db-glass-panel {
        background: var(--panel-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: var(--glass-shadow);
        backdrop-filter: var(--backdrop-blur);
    }

    /* Buttons */
    .btn-db {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid transparent;
        transition: all 0.2s ease;
        font-family: inherit;
        text-decoration: none;
    }

    .btn-db-sm {
        padding: 5px 12px;
        font-size: 0.78rem;
        border-radius: 6px;
    }

    .btn-db-emerald {
        background: linear-gradient(135deg, var(--accent-emerald), #059669);
        color: #fff;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
    }

    .btn-db-emerald:hover {
        background: linear-gradient(135deg, var(--accent-emerald-hover), var(--accent-emerald));
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4);
        transform: translateY(-1px);
        color: #fff;
    }

    .btn-db-gold {
        background: rgba(245, 158, 11, 0.12);
        color: var(--accent-gold);
        border-color: rgba(245, 158, 11, 0.3);
    }

    .btn-db-gold:hover {
        background: rgba(245, 158, 11, 0.22);
        border-color: var(--accent-gold);
    }

    .btn-db-ghost {
        background: rgba(255, 255, 255, 0.04);
        color: var(--text-secondary);
        border-color: var(--border-color);
    }

    .btn-db-ghost:hover {
        background: rgba(16, 185, 129, 0.08);
        color: var(--text-primary);
        border-color: var(--accent-emerald);
    }

    .btn-db-red {
        background: rgba(239, 68, 68, 0.12);
        color: #f87171;
        border-color: rgba(239, 68, 68, 0.25);
    }

    .btn-db-red:hover {
        background: rgba(239, 68, 68, 0.22);
        border-color: #ef4444;
    }

    /* Form Inputs */
    .db-input-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .db-input {
        width: 100%;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 10px 14px;
        color: var(--text-primary);
        font-size: 0.85rem;
        outline: none;
        font-family: inherit;
        transition: all 0.2s ease;
    }

    .db-input:focus {
        border-color: var(--accent-emerald);
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.2);
    }

    .db-input-textarea {
        resize: vertical;
        min-height: 80px;
    }

    /* Modal */
    .db-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-color);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .db-modal-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        overflow-y: auto;
        max-height: 65vh;
    }

    .db-modal-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding: 14px 20px;
        border-top: 1px solid var(--border-color);
        background: rgba(0, 0, 0, 0.15);
    }


    /* PROJECT MANAGEMENT PANEL CUSTOM STYLES */
    .pm-nav-tabs {
        display: flex;
        gap: 8px;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 24px;
        padding-bottom: 8px;
    }

    .pm-tab-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--text-secondary);
        padding: 10px 20px;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pm-tab-btn:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-primary);
    }

    .pm-tab-btn.active {
        background: rgba(16, 185, 129, 0.15);
        color: var(--accent-emerald);
        border-color: rgba(16, 185, 129, 0.3);
    }

    .pm-section {
        display: none;
        animation: fadeIn 0.3s ease;
    }

    .pm-section.active {
        display: block;
    }

    /* METRIC CARDS */
    .metric-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .metric-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px;
        box-shadow: var(--glass-shadow);
        display: flex;
        align-items: center;
        gap: 16px;
        transition: all 0.2s ease;
    }

    .metric-card:hover {
        border-color: var(--border-hover);
        transform: translateY(-2px);
    }

    .metric-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: rgba(16, 185, 129, 0.12);
        color: var(--accent-emerald);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .metric-info {
        display: flex;
        flex-direction: column;
    }

    .metric-label {
        font-size: 0.78rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .metric-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-primary);
        margin-top: 2px;
    }

    /* GANTT CHART */
    .gantt-container {
        background: var(--panel-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        overflow-x: auto;
        box-shadow: var(--glass-shadow);
    }

    .gantt-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 12px;
    }

    .gantt-chart-wrapper {
        min-width: 800px;
        position: relative;
    }

    .gantt-timeline {
        display: grid;
        grid-template-columns: 200px 1fr;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
        font-weight: 700;
        font-size: 0.78rem;
        color: var(--accent-gold);
    }

    .gantt-days {
        display: flex;
        position: relative;
        justify-content: space-between;
        padding-left: 10px;
        padding-right: 10px;
    }

    .gantt-row {
        display: grid;
        grid-template-columns: 200px 1fr;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.03);
        position: relative;
    }

    .gantt-row:hover {
        background: rgba(255,255,255,0.01);
    }

    .gantt-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-right: 15px;
    }

    .gantt-bar-area {
        position: relative;
        height: 28px;
        background: rgba(255,255,255,0.02);
        border-radius: 4px;
    }

    .gantt-bar {
        position: absolute;
        height: 100%;
        border-radius: 4px;
        display: flex;
        align-items: center;
        padding: 0 8px;
        font-size: 0.72rem;
        color: white;
        font-weight: 700;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .gantt-bar-normal {
        background: linear-gradient(90deg, #10b981, #059669);
        border: 1px solid rgba(16, 185, 129, 0.4);
    }

    .gantt-bar-critical {
        background: linear-gradient(90deg, #ef4444, #dc2626);
        border: 1px solid rgba(239, 68, 68, 0.4);
        animation: pulseBorder 2s infinite;
    }

    .gantt-progress {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        background: rgba(255, 255, 255, 0.15);
        pointer-events: none;
    }

    /* TEAM CARDS */
    .team-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
    }

    .team-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        box-shadow: var(--glass-shadow);
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
    }

    .team-card:hover {
        border-color: var(--border-hover);
        transform: translateY(-4px);
    }

    .team-avatar {
        width: 64px;
        height: 64px;
        background: rgba(16, 185, 129, 0.15);
        color: var(--accent-emerald);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        margin-bottom: 16px;
        border: 2px solid var(--border-color);
    }

    .team-name {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .team-role {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--accent-gold);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 12px;
    }

    .team-info-row {
        width: 100%;
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: var(--text-secondary);
        padding: 6px 0;
        border-bottom: 1px solid rgba(255,255,255,0.03);
    }

    .team-info-row:last-child {
        border-bottom: none;
    }

    /* MODAL AND FORMS */
    .pm-modal {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: var(--backdrop-blur);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .pm-modal.open {
        display: flex;
    }

    .pm-modal-content {
        background: #06120b;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        width: 100%;
        max-width: 520px;
        box-shadow: var(--glass-shadow);
        overflow: hidden;
        animation: scaleUp 0.25s ease-out;
    }

    @@keyframes scaleUp {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes pulseBorder {
        0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
        70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
        100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }

    :root {
        --gantt-day-width: 48px;
    }

    .gantt-split-container {
        display: grid;
        grid-template-columns: 320px 1fr;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        background: var(--panel-bg);
        box-shadow: var(--glass-shadow);
        margin-top: 15px;
    }

    .gantt-sidebar {
        border-right: 1px solid var(--border-color);
        background: rgba(0, 0, 0, 0.25);
        display: flex;
        flex-direction: column;
    }

    .gantt-sidebar-header {
        height: 60px;
        display: flex;
        align-items: center;
        padding: 0 16px;
        background: rgba(0, 0, 0, 0.45);
        border-bottom: 1px solid var(--border-color);
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--accent-gold);
    }

    .gantt-sidebar-body {
        display: flex;
        flex-direction: column;
    }

    .gantt-sidebar-row {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        box-sizing: border-box;
    }

    .gantt-sidebar-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .gantt-sidebar-dates {
        display: flex;
        gap: 6px;
        margin-top: 2px;
    }

    .gantt-date-badge {
        font-size: 0.65rem;
        padding: 1px 5px;
        border-radius: 3px;
        font-weight: 700;
    }

    .gantt-date-badge.start {
        background: rgba(16, 185, 129, 0.12);
        color: var(--accent-emerald);
        border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .gantt-date-badge.end {
        background: rgba(245, 158, 11, 0.12);
        color: var(--accent-gold);
        border: 1px solid rgba(245, 158, 11, 0.25);
    }

    .gantt-timeline-scroll {
        overflow-x: auto;
        background: rgba(0, 0, 0, 0.1);
    }

    .gantt-timeline-grid {
        width: max-content;
        display: flex;
        flex-direction: column;
    }

    .gantt-timeline-header {
        height: 60px;
        display: flex;
        flex-direction: column;
        background: rgba(0, 0, 0, 0.45);
        border-bottom: 1px solid var(--border-color);
    }

    .gantt-header-row {
        display: flex;
        height: 60px;
        align-items: center;
    }

    .gantt-header-cell {
        width: var(--gantt-day-width);
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        font-size: 0.65rem;
        font-weight: 600;
        box-sizing: border-box;
    }

    .gantt-header-cell.weekend {
        background: rgba(255, 255, 255, 0.03);
        color: var(--text-secondary);
    }

    .gantt-header-cell .day-lbl {
        color: var(--accent-gold);
        font-weight: 700;
        margin-bottom: 2px;
    }

    .gantt-header-cell .date-lbl {
        color: var(--text-secondary);
        font-size: 0.62rem;
    }

    .gantt-tracks {
        display: flex;
        flex-direction: column;
    }

    .gantt-track-row {
        display: flex;
        position: relative;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        box-sizing: border-box;
    }

    .gantt-cell-bg {
        width: var(--gantt-day-width);
        height: 100%;
        flex-shrink: 0;
        border-right: 1px solid rgba(255, 255, 255, 0.03);
        box-sizing: border-box;
    }

    .gantt-cell-bg.weekend {
        background: rgba(255, 255, 255, 0.015);
    }

    .gantt-track-row .gantt-bar {
        height: 30px;
        line-height: 30px;
        display: flex;
        align-items: center;
        box-shadow: 0 3px 6px rgba(0,0,0,0.4);
    }

    .gantt-bar-text {
        font-size: 0.68rem;
        font-weight: 700;
        color: white;
        margin-left: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        position: relative;
        z-index: 2;
    }
</style>

<div class="db-manager-container">
    <div class="db-header">
        <h2 class="db-title">📊 Proje Yönetimi ve İş Akışı Paneli</h2>
        <div style="display:flex; gap:10px;">
            <button class="btn-db btn-db-sm btn-db-gold" onclick="openModal('modal-project-meta')">✏️ Proje Detayları</button>
            <span style="background: rgba(245, 158, 11, 0.15); color: var(--accent-gold); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 20px; padding: 4px 12px; font-size: 0.75rem; font-weight: 700; display: flex; align-items:center;">
                📌 Statü: @project.Status
            </span>
        </div>
    </div>

    <!-- PROJECT METRIC BARS -->
    <div class="db-glass-panel" style="padding: 20px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-weight:700; font-size:0.9rem;">
            <span>🚀 Proje: <strong style="color:var(--accent-gold)">@project.Name</strong></span>
            <span style="color:var(--accent-emerald)">@project.Progress% Tamamlandı</span>
        </div>
        <div style="background: rgba(255,255,255,0.05); height: 10px; border-radius: 5px; overflow:hidden;">
            <div style="background: linear-gradient(90deg, var(--accent-emerald), #34d399); width: @project.Progress%; height:100%; border-radius:5px; transition: width 0.5s ease;"></div>
        </div>
        <div style="display:flex; justify-content:space-between; margin-top:8px; font-size:0.75rem; color:var(--text-secondary)">
            <span>Başlangıç: @project.StartDate.ToString("dd.MM.yyyy")</span>
            <span>Öngörülen Bitiş: @project.EndDate.ToString("dd.MM.yyyy")</span>
        </div>
        <div style="font-size:0.82rem; color:var(--text-secondary); margin-top:10px; border-top:1px solid rgba(255,255,255,0.03); padding-top:10px;">
            📄 <strong>Proje Tanımı:</strong> @project.Description
        </div>
    </div>

    <!-- TABS -->
    <div class="pm-nav-tabs">
        <button class="pm-tab-btn active" id="tab-btn-dashboard" onclick="switchTab('dashboard')">📈 Genel Durum</button>
        <button class="pm-tab-btn" id="tab-btn-gantt" onclick="switchTab('gantt')">📅 Gantt Şeması</button>
        <button class="pm-tab-btn" id="tab-btn-cpm" onclick="switchTab('cpm')">🏗️ Görevler ve CPM</button>
        <button class="pm-tab-btn" id="tab-btn-team" onclick="switchTab('team')">👥 Proje Ekibi</button>
        <button class="pm-tab-btn" id="tab-btn-capital" onclick="switchTab('capital')">💰 Bütçe ve Sermaye</button>
        <button class="pm-tab-btn" id="tab-btn-reports" onclick="switchTab('reports')">📋 Raporlar</button>
    </div>

    <!-- 1. DASHBOARD TAB -->
    <div id="sec-dashboard" class="pm-section active">
        <div class="metric-grid">
            <div class="metric-card">
                <div class="metric-icon">🚀</div>
                <div class="metric-info">
                    <span class="metric-label">Toplam Görev</span>
                    <span class="metric-value">@totalTasks</span>
                </div>
            </div>
            <div class="metric-card">
                <div class="metric-icon" style="background:rgba(16, 185, 129, 0.12); color:var(--accent-emerald)">✅</div>
                <div class="metric-info">
                    <span class="metric-label">Tamamlanan</span>
                    <span class="metric-value">@completedTasks</span>
                </div>
            </div>
            <div class="metric-card">
                <div class="metric-icon" style="background:rgba(239, 68, 68, 0.12); color:#ef4444">⚡</div>
                <div class="metric-info">
                    <span class="metric-label">Kritik Görev</span>
                    <span class="metric-value">@criticalTasks</span>
                </div>
            </div>
            <div class="metric-card">
                <div class="metric-icon" style="background:rgba(245, 158, 11, 0.12); color:var(--accent-gold)">⏱️</div>
                <div class="metric-info">
                    <span class="metric-label">En Kısa Süre (CPM)</span>
                    <span class="metric-value">@projectDuration Gün</span>
                </div>
            </div>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-bottom:24px;">
            <div class="db-glass-panel" style="padding:24px;">
                <h3 class="premium-card-title">💵 Sermaye ve Bütçe Dengesi</h3>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin: 15px 0;">
                    <div style="background:rgba(16,185,129,0.04); border: 1px solid rgba(16,185,129,0.1); padding:16px; border-radius:8px;">
                        <div style="font-size:0.75rem; color:var(--text-secondary)">TOPLAM SERMAYE</div>
                        <div style="font-size:1.4rem; font-weight:800; color:var(--accent-emerald);">@totalIncomes.ToString("N2") TL</div>
                    </div>
                    <div style="background:rgba(239,68,68,0.04); border: 1px solid rgba(239,68,68,0.1); padding:16px; border-radius:8px;">
                        <div style="font-size:0.75rem; color:var(--text-secondary)">HARCANAN BÜTÇE</div>
                        <div style="font-size:1.4rem; font-weight:800; color:#ef4444;">@totalExpenses.ToString("N2") TL</div>
                    </div>
                </div>

                <div style="margin-top:20px;">
                    <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:0.8rem; font-weight:600;">
                        <span>Proje Bütçe Kullanımı: @project.Budget.ToString("N0") TL</span>
                        <span style="color:var(--accent-gold);">@budgetUsagePercent.ToString("N1")% Kullanıldı</span>
                    </div>
                    <div style="background: rgba(255,255,255,0.05); height: 8px; border-radius: 4px; overflow:hidden;">
                        <div style="background: var(--accent-gold); width: @(budgetUsagePercent > 100 ? 100 : budgetUsagePercent)%; height:100%; border-radius:4px;"></div>
                    </div>
                </div>
            </div>

            <div class="db-glass-panel" style="padding:24px;">
                <h3 class="premium-card-title">📊 Proje Finansal Durumu</h3>
                <div style="display:flex; flex-direction:column; gap:12px; margin-top:15px;">
                    <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid rgba(255,255,255,0.03);">
                        <span>💰 Öngörülen Proje Bütçesi:</span>
                        <span style="font-weight:700; color:var(--text-primary);">@project.Budget.ToString("N2") TL</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid rgba(255,255,255,0.03);">
                        <span>💼 Aktif Kasa Sermayesi:</span>
                        <span style="font-weight:700; color:var(--accent-emerald);">@project.Capital.ToString("N2") TL</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid rgba(255,255,255,0.03);">
                        <span>📥 Alınan Toplam Destek/Gelir:</span>
                        <span style="font-weight:700; color:var(--accent-emerald);">@totalIncomes.ToString("N2") TL</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; padding:8px 0;">
                        <span>📤 Net Kasa Bakiyesi (Gelir-Gider):</span>
                        <span style="font-weight:700; color: @(currentBalance >= 0 ? "var(--accent-emerald)" : "#ef4444");">
                            @currentBalance.ToString("N2") TL
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. GANTT CHART TAB -->
    <div id="sec-gantt" class="pm-section">
        <div class="gantt-container" style="padding: 16px 24px;">
            <div class="gantt-header" style="margin-bottom: 12px;">
                <div>
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--accent-gold); margin: 0;">📅 Takvim Uyumlu Gantt Şeması</h3>
                    <span style="font-size: 0.75rem; color: var(--text-secondary);">Başlangıç ve bitiş tarihlerine göre sıralanmış takvim yerleşimi</span>
                </div>
                <div style="display:flex; gap:6px;">
                    <button class="btn-db btn-db-sm btn-db-emerald" onclick="toggleGanttView('task')">📋 Göreve Göre</button>
                    <button class="btn-db btn-db-sm btn-db-ghost" onclick="toggleGanttView('team')">👥 Ekibe Göre</button>
                </div>
            </div>

            <!-- GÖREVE GÖRE GANTT -->
            <div id="gantt-task-view" class="gantt-split-container">
                <!-- SOL TARAF: GÖREV LİSTESİ -->
                <div class="gantt-sidebar">
                    <div class="gantt-sidebar-header">
                        <span>Görev Tanımı ve Tarihler</span>
                    </div>
                    <div class="gantt-sidebar-body">
                        @foreach (var task in Model.Tasks.OrderBy(t => t.EarlyStart).ThenBy(t => t.EarlyFinish))
                        {
                            var startDate = project.StartDate.AddDays(task.EarlyStart);
                            var endDate = project.StartDate.AddDays(task.EarlyFinish);
                            
                            <div class="gantt-sidebar-row" style="height: 52px;">
                                <div class="gantt-sidebar-title" title="@task.TaskName">
                                    @if (task.IsCritical)
                                    {
                                        <span style="color:#ef4444; font-weight:bold; margin-right:4px;">⚠️</span>
                                    }
                                    @task.TaskName
                                </div>
                                <div class="gantt-sidebar-dates">
                                    <span class="gantt-date-badge start">📅 @startDate.ToString("dd.MM.yyyy")</span>
                                    <span class="gantt-date-badge end">🏁 @endDate.ToString("dd.MM.yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- SAĞ TARAF: ZAMAN ÇİZELGESİ (SCROLLABLE) -->
                <div class="gantt-timeline-scroll">
                    <div class="gantt-timeline-grid">
                        <!-- HEADER -->
                        <div class="gantt-timeline-header">
                            <div class="gantt-header-row">
                                @{
                                    string[] trDays = { "Pz", "Pt", "Sa", "Ça", "Pe", "Cu", "Ct" };
                                }
                                @for (int i = 0; i <= projectDuration; i++)
                                {
                                    var date = project.StartDate.AddDays(i);
                                    var isWeekend = date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
                                    var dayName = trDays[(int)date.DayOfWeek];
                                    
                                    <div class="gantt-header-cell @(isWeekend ? "weekend" : "")">
                                        <span class="day-lbl">@dayName</span>
                                        <span class="date-lbl">@date.ToString("dd/MM")</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- GÖREVLER -->
                        <div class="gantt-tracks">
                            @{
                                const int ganttDayW = 48;
                            }
                            @foreach (var task in Model.Tasks.OrderBy(t => t.EarlyStart).ThenBy(t => t.EarlyFinish))
                            {
                                var member = Model.Team.FirstOrDefault(m => m.Id == task.AssigneeId);
                                var barLeft = task.EarlyStart * ganttDayW;
                                var barWidth = task.DurationDays * ganttDayW;
                                if (barWidth < 4) { barWidth = 4; }
                                
                                <div class="gantt-track-row" style="height: 52px; overflow: hidden;">
                                    <!-- Background cells -->
                                    @for (int i = 0; i <= projectDuration; i++)
                                    {
                                        var date = project.StartDate.AddDays(i);
                                        var isWeekend = date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
                                        <div class="gantt-cell-bg @(isWeekend ? "weekend" : "")"></div>
                                    }

                                    <!-- Render the task bar -->
                                    <div class="gantt-bar @(task.IsCritical ? "gantt-bar-critical" : "gantt-bar-normal")"
                                         style="position: absolute; left: @(barLeft)px; width: @(barWidth)px; top: 11px; height: 30px;"
                                         title="@task.TaskName (Gün @task.EarlyStart - @task.EarlyFinish) | Süre: @task.DurationDays Gün">
                                        <div class="gantt-progress" style="width: @task.ProgressPercent%;"></div>
                                        <span class="gantt-bar-text">
                                            @(member != null ? member.Name : "Atanmadı") (@task.ProgressPercent%)
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- EKİBE GÖRE GANTT (İş Yükü Çizelgesi) -->
            <div id="gantt-team-view" class="gantt-split-container" style="display: none;">
                <!-- SOL TARAF: EKİP LİSTESİ -->
                <div class="gantt-sidebar">
                    <div class="gantt-sidebar-header">
                        <span>Ekip Üyesi</span>
                    </div>
                    <div class="gantt-sidebar-body">
                        @foreach (var member in Model.Team)
                        {
                            <div class="gantt-sidebar-row" style="height: 60px;">
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <span style="font-size:1.15rem;">@member.Avatar</span>
                                    <div style="display:flex; flex-direction:column; min-width:0;">
                                        <strong style="font-size:0.8rem; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@member.Name</strong>
                                        <span style="font-size:0.65rem; color:var(--accent-gold); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@member.Role</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- SAĞ TARAF: ZAMAN ÇİZELGESİ (SCROLLABLE) -->
                <div class="gantt-timeline-scroll">
                    <div class="gantt-timeline-grid">
                        <!-- HEADER -->
                        <div class="gantt-timeline-header">
                            <div class="gantt-header-row">
                                @{
                                    string[] trDaysTeam = { "Pz", "Pt", "Sa", "Ça", "Pe", "Cu", "Ct" };
                                }
                                @for (int i = 0; i <= projectDuration; i++)
                                {
                                    var date = project.StartDate.AddDays(i);
                                    var isWeekend = date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
                                    var dayName = trDaysTeam[(int)date.DayOfWeek];
                                    
                                    <div class="gantt-header-cell @(isWeekend ? "weekend" : "")">
                                        <span class="day-lbl">@dayName</span>
                                        <span class="date-lbl">@date.ToString("dd/MM")</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- EKİP GÖREVLERİ -->
                        <div class="gantt-tracks">
                            @foreach (var member in Model.Team)
                            {
                                var memberTasks = Model.Tasks.Where(t => t.AssigneeId == member.Id).ToList();
                                
                                <div class="gantt-track-row" style="height: 60px; overflow: hidden;">
                                    <!-- Background cells -->
                                    @for (int i = 0; i <= projectDuration; i++)
                                    {
                                        var date = project.StartDate.AddDays(i);
                                        var isWeekend = date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
                                        <div class="gantt-cell-bg @(isWeekend ? "weekend" : "")"></div>
                                    }

                                    <!-- Render multiple tasks inside the team member track -->
                                    @if (memberTasks.Count == 0)
                                    {
                                        <span style="position: absolute; left: 12px; top: 22px; font-size: 0.72rem; color: var(--text-muted); font-style: italic; z-index: 2;">Boşta (Görev Atanmadı)</span>
                                    }
                                    else
                                    {
                                        foreach (var task in memberTasks)
                                        {
                                            var tLeft = task.EarlyStart * 48;
                                            var tWidth = task.DurationDays * 48;
                                            if (tWidth < 4) { tWidth = 4; }
                                            <div class="gantt-bar @(task.IsCritical ? "gantt-bar-critical" : "gantt-bar-normal")"
                                                 style="position: absolute; left: @(tLeft)px; width: @(tWidth)px; height: 32px; top: 14px;"
                                                 title="@task.TaskName (Gün @task.EarlyStart - @task.EarlyFinish)">
                                                <div class="gantt-progress" style="width: @task.ProgressPercent%;"></div>
                                                <span class="gantt-bar-text">@task.TaskName (@task.ProgressPercent%)</span>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. TASKS & CPM TAB -->
    <div id="sec-cpm" class="pm-section">
        <div style="display: flex; justify-content: flex-end; margin-bottom: 16px;">
            <button class="btn-db btn-db-emerald" onclick="openModal('modal-add-task')">➕ Yeni Görev Ekle</button>
        </div>

        <div class="premium-table-container">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Görev Adı</th>
                        <th>Sorumlu</th>
                        <th>Süre</th>
                        <th>İlerleme</th>
                        <th>Öncüller</th>
                        <th>ES (Erken Başlama)</th>
                        <th>EF (Erken Bitiş)</th>
                        <th>LS (Geç Başlama)</th>
                        <th>LF (Geç Bitiş)</th>
                        <th>Bolluk (Slack)</th>
                        <th>Kritik Yol</th>
                        <th style="width:50px;">Aksiyon</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model.Tasks.OrderBy(t => t.Id))
                    {
                        var member = Model.Team.FirstOrDefault(m => m.Id == task.AssigneeId);
                        
                        <tr>
                            <td style="font-weight: bold; color: var(--accent-gold);">#@task.Id</td>
                            <td>
                                @if (task.IsCritical)
                                {
                                    <span style="color:#ef4444; font-weight:bold; margin-right:4px;" title="Kritik Görev">⚠️</span>
                                }
                                <strong style="@(task.IsCritical ? "color:#f87171;" : "color:var(--text-primary);")">@task.TaskName</strong>
                            </td>
                            <td>@(member != null ? $"{member.Avatar} {member.Name}" : "—")</td>
                            <td><strong>@task.DurationDays</strong> Gün</td>
                            <td>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <span style="font-size:0.75rem; min-width:30px;">@task.ProgressPercent%</span>
                                    <div style="background: rgba(255,255,255,0.05); height: 6px; width: 60px; border-radius: 3px; overflow:hidden;">
                                        <div style="background: var(--accent-emerald); width: @task.ProgressPercent%; height:100%;"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @(task.PredecessorTaskIds.Count > 0 ? string.Join(", ", task.PredecessorTaskIds.Select(id => $"#{id}")) : "Yok")
                            </td>
                            <td style="text-align:center;">@task.EarlyStart</td>
                            <td style="text-align:center;">@task.EarlyFinish</td>
                            <td style="text-align:center;">@task.LateStart</td>
                            <td style="text-align:center;">@task.LateFinish</td>
                            <td style="text-align:center; font-weight:bold; color: @(task.Slack == 0 ? "#ef4444" : "var(--accent-emerald)");">
                                @task.Slack
                            </td>
                            <td>
                                @if (task.IsCritical)
                                {
                                    <span class="zirai-badge zirai-badge-danger" style="animation: pulseBorder 2s infinite;">Evet (Kritik)</span>
                                }
                                else
                                {
                                    <span class="zirai-badge zirai-badge-emerald">Hayır</span>
                                }
                            </td>
                            <td>
                                <form asp-action="DeleteTask" method="post" onsubmit="return confirm('Görev silinsin mi?');">
                                    <input type="hidden" name="id" value="@task.Id" />
                                    <button type="submit" class="btn-db btn-db-sm btn-db-red" style="padding: 2px 6px;">🗑️</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 4. TEAM TAB -->
    <div id="sec-team" class="pm-section">
        <div class="team-grid">
            @foreach (var member in Model.Team)
            {
                var tasksCount = Model.Tasks.Count(t => t.AssigneeId == member.Id);
                var criticalTasksCount = Model.Tasks.Count(t => t.AssigneeId == member.Id && t.IsCritical);

                <div class="team-card">
                    <div class="team-avatar">@member.Avatar</div>
                    <div class="team-name">@member.Name</div>
                    <div class="team-role">@member.Role</div>
                    <div style="font-size:0.8rem; color:var(--accent-emerald); background:rgba(16,185,129,0.08); padding:3px 10px; border-radius:12px; margin-bottom:15px; border:1px solid rgba(16,185,129,0.15)">
                        @member.Specialty
                    </div>
                    
                    <div class="team-info-row">
                        <span>📧 E-Posta:</span>
                        <span style="color:var(--text-primary);">@member.Email</span>
                    </div>
                    <div class="team-info-row">
                        <span>📞 Telefon:</span>
                        <span style="color:var(--text-primary);">@member.Phone</span>
                    </div>
                    <div class="team-info-row">
                        <span>📋 Aktif Görev:</span>
                        <span style="font-weight:700; color:var(--text-primary);">@tasksCount</span>
                    </div>
                    <div class="team-info-row">
                        <span>⚡ Kritik Görev:</span>
                        <span style="font-weight:700; color:#ef4444;">@criticalTasksCount</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 5. BUDGET AND CAPITAL TAB -->
    <div id="sec-capital" class="pm-section">
        <div style="display:grid; grid-template-columns: 1.3fr 1fr; gap:20px;">
            <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--accent-gold); margin: 0;">💵 Gelir-Gider İşlemleri</h3>
                    <span style="font-size:0.75rem; color:var(--text-secondary)">Kasa hareketleri listesi</span>
                </div>
                <div class="premium-table-container" style="margin-top:0; max-height:450px; overflow-y:auto;">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Tür</th>
                                <th>Kategori</th>
                                <th>Açıklama</th>
                                <th style="text-align:right;">Tutar</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in Model.Transactions.OrderByDescending(t => t.Date))
                            {
                                <tr>
                                    <td>@tx.Date.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (tx.Type == "Gelir")
                                        {
                                            <span class="zirai-badge zirai-badge-emerald">Gelir / Destek</span>
                                        }
                                        else
                                        {
                                            <span class="zirai-badge zirai-badge-danger">Gider / Ödeme</span>
                                        }
                                    </td>
                                    <td>@tx.Category</td>
                                    <td title="@tx.Description">@tx.Description</td>
                                    <td style="text-align:right; font-weight:bold; color: @(tx.Type == "Gelir" ? "var(--accent-emerald)" : "#ef4444");">
                                        @(tx.Type == "Gelir" ? "+" : "-")@tx.Amount.ToString("N2") TL
                                    </td>
                                    <td>
                                        <form asp-action="DeleteTransaction" method="post" onsubmit="return confirm('Kasa hareketi silinsin mi?');">
                                            <input type="hidden" name="id" value="@tx.Id" />
                                            <button type="submit" class="btn-db btn-db-sm btn-db-red" style="padding: 1px 4px; font-size:0.65rem;">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="db-glass-panel" style="padding:24px; height:fit-content;">
                <h3 class="premium-card-title">➕ Yeni Nakit Hareketi Ekle</h3>
                <form asp-action="AddTransaction" method="post" style="display:flex; flex-direction:column; gap:16px; margin-top:15px;">
                    <div class="db-input-group">
                        <label class="premium-form-label">Hareket Türü *</label>
                        <select name="type" class="db-input premium-input" required>
                            <option value="Gelir">Gelir (Sermaye/Hibe/Yatırım)</option>
                            <option value="Gider">Gider (Harcama/Maaş/Ekipman)</option>
                        </select>
                    </div>
                    <div class="db-input-group">
                        <label class="premium-form-label">Tutar (TL) *</label>
                        <input type="number" name="amount" step="0.01" class="db-input premium-input" placeholder="Örn: 25000" required />
                    </div>
                    <div class="db-input-group">
                        <label class="premium-form-label">Kategori *</label>
                        <input type="text" name="category" class="db-input premium-input" placeholder="Örn: Ekipman, Maaş, Hibe" required />
                    </div>
                    <div class="db-input-group">
                        <label class="premium-form-label">Açıklama</label>
                        <input type="text" name="description" class="db-input premium-input" placeholder="Örn: Ar-Ge sunucu lisansı alımı" />
                    </div>
                    <button type="submit" class="btn-premium btn-premium-emerald" style="justify-content:center;">💾 Nakit Hareketini Kaydet</button>
                </form>
            </div>
        </div>
    </div>

    <!-- 6. REPORTS TAB -->
    <div id="sec-reports" class="pm-section">
        @{
            // ─── Hesaplamalar ────────────────────────────────────────────────
            var elapsedDaysRep    = Math.Max(0, (DateTime.Now - project.StartDate).Days);
            var totalProjDaysRep  = Math.Max(1, (project.EndDate - project.StartDate).Days);
            var timeElapsedPct    = Math.Min(100.0, (double)elapsedDaysRep / totalProjDaysRep * 100);

            var completedCriticalRep  = Model.Tasks.Count(t => t.IsCritical && t.ProgressPercent == 100);
            var criticalTasksRep      = Model.Tasks.Count(t => t.IsCritical);
            var criticalPctRep        = criticalTasksRep > 0 ? (double)completedCriticalRep / criticalTasksRep * 100 : 100;

            // Maaş maliyet hesabı: her üye kendi görevlerinin toplam gün süresini çalışır
            var totalPayrollCost = 0.0;
            foreach (var m in Model.Team)
            {
                var memberDays = Model.Tasks.Where(t => t.AssigneeId == m.Id).Sum(t => t.DurationDays);
                totalPayrollCost += memberDays * m.DailySalary;
            }

            // Bütçe sapması
            var budgetDeviation   = totalExpenses - project.Budget;
            var remainingBudget   = project.Budget - totalExpenses;

            // Kategori bazlı gider dağılımı
            var expensesByCategory = Model.Transactions
                .Where(t => t.Type == "Gider")
                .GroupBy(t => t.Category)
                .Select(g => new { Category = g.Key, Total = g.Sum(t => t.Amount) })
                .OrderByDescending(x => x.Total)
                .ToList();

            // Kategori bazlı gelir dağılımı
            var incomesByCategory = Model.Transactions
                .Where(t => t.Type == "Gelir")
                .GroupBy(t => t.Category)
                .Select(g => new { Category = g.Key, Total = g.Sum(t => t.Amount) })
                .OrderByDescending(x => x.Total)
                .ToList();

            // SPI (Schedule Performance Index) = İlerleme% / ZamanGeçen%
            var spi = timeElapsedPct > 0 ? project.Progress / timeElapsedPct : 1.0;
            // CPI (Cost Performance Index) = Planlanan bütçe / Harcanan bütçe
            var cpi = totalExpenses > 0 ? project.Budget / totalExpenses : 1.0;
        }

        <!-- ─── ÖZET KPI KARTLARI ─── -->
        <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:16px; margin-bottom:24px;">
            <div class="db-glass-panel" style="padding:18px; text-align:center;">
                <div style="font-size:1.8rem; margin-bottom:6px;">💰</div>
                <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-secondary); margin-bottom:4px;">Toplam Gelir</div>
                <div style="font-size:1.3rem; font-weight:800; color:var(--accent-emerald);">@totalIncomes.ToString("N0") TL</div>
            </div>
            <div class="db-glass-panel" style="padding:18px; text-align:center;">
                <div style="font-size:1.8rem; margin-bottom:6px;">📤</div>
                <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-secondary); margin-bottom:4px;">Toplam Gider</div>
                <div style="font-size:1.3rem; font-weight:800; color:#ef4444;">@totalExpenses.ToString("N0") TL</div>
            </div>
            <div class="db-glass-panel" style="padding:18px; text-align:center;">
                <div style="font-size:1.8rem; margin-bottom:6px;">🏦</div>
                <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-secondary); margin-bottom:4px;">Net Kasa Bakiyesi</div>
                <div style="font-size:1.3rem; font-weight:800; color:@(currentBalance >= 0 ? "var(--accent-emerald)" : "#ef4444");">@currentBalance.ToString("N0") TL</div>
            </div>
            <div class="db-glass-panel" style="padding:18px; text-align:center;">
                <div style="font-size:1.8rem; margin-bottom:6px;">@(remainingBudget >= 0 ? "✅" : "⚠️")</div>
                <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-secondary); margin-bottom:4px;">Kalan Bütçe</div>
                <div style="font-size:1.3rem; font-weight:800; color:@(remainingBudget >= 0 ? "var(--accent-emerald)" : "#ef4444");">@remainingBudget.ToString("N0") TL</div>
            </div>
        </div>

        <!-- ─── SATIR 1: GELİR-GİDER TABLOSU + PROJE TAKVİMİ ─── -->
        <div style="display:grid; grid-template-columns: 1.2fr 1fr; gap:20px; margin-bottom:20px;">

            <!-- GELİR-GİDER KATEGORİ RAPORU -->
            <div class="db-glass-panel" style="padding:22px;">
                <h3 class="premium-card-title">📊 Gelir / Gider Kategori Raporu</h3>

                <!-- GELİRLER -->
                <div style="margin-top:16px; margin-bottom:12px;">
                    <div style="font-size:0.75rem; font-weight:700; color:var(--accent-emerald); text-transform:uppercase; letter-spacing:0.8px; margin-bottom:10px; display:flex; align-items:center; gap:6px;">
                        <span style="width:8px; height:8px; border-radius:50%; background:var(--accent-emerald); display:inline-block;"></span> GELİRLER
                    </div>
                    @foreach (var inc in incomesByCategory)
                    {
                        var incPct = totalIncomes > 0 ? inc.Total / totalIncomes * 100 : 0;
                        <div style="margin-bottom:10px;">
                            <div style="display:flex; justify-content:space-between; font-size:0.8rem; margin-bottom:4px;">
                                <span style="color:var(--text-secondary);">@inc.Category</span>
                                <span style="font-weight:700; color:var(--accent-emerald);">@inc.Total.ToString("N0") TL <span style="color:var(--text-muted); font-weight:400; font-size:0.72rem;">(@incPct.ToString("N0")%)</span></span>
                            </div>
                            <div style="background:rgba(255,255,255,0.05); height:6px; border-radius:3px; overflow:hidden;">
                                <div style="background:var(--accent-emerald); width:@incPct%; height:100%; border-radius:3px;"></div>
                            </div>
                        </div>
                    }
                </div>

                <div style="border-top:1px solid var(--border-color); margin:14px 0;"></div>

                <!-- GİDERLER -->
                <div>
                    <div style="font-size:0.75rem; font-weight:700; color:#ef4444; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:10px; display:flex; align-items:center; gap:6px;">
                        <span style="width:8px; height:8px; border-radius:50%; background:#ef4444; display:inline-block;"></span> GİDERLER
                    </div>
                    @foreach (var exp in expensesByCategory)
                    {
                        var expPct = totalExpenses > 0 ? exp.Total / totalExpenses * 100 : 0;
                        <div style="margin-bottom:10px;">
                            <div style="display:flex; justify-content:space-between; font-size:0.8rem; margin-bottom:4px;">
                                <span style="color:var(--text-secondary);">@exp.Category</span>
                                <span style="font-weight:700; color:#ef4444;">@exp.Total.ToString("N0") TL <span style="color:var(--text-muted); font-weight:400; font-size:0.72rem;">(@expPct.ToString("N0")%)</span></span>
                            </div>
                            <div style="background:rgba(255,255,255,0.05); height:6px; border-radius:3px; overflow:hidden;">
                                <div style="background:#ef4444; width:@expPct%; height:100%; border-radius:3px;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- PROJE TAKVİM VE PERFORMANS ENDEKSİ -->
            <div class="db-glass-panel" style="padding:22px;">
                <h3 class="premium-card-title">📅 Proje Takvim Raporu</h3>
                <div style="display:flex; flex-direction:column; gap:14px; margin-top:16px;">

                    <!-- Zaman İlerlemesi -->
                    <div>
                        <div style="display:flex; justify-content:space-between; font-size:0.8rem; font-weight:600; margin-bottom:5px;">
                            <span>⏱️ Takvim İlerlemesi</span>
                            <span style="color:var(--accent-gold);">@timeElapsedPct.ToString("N0")%</span>
                        </div>
                        <div style="background:rgba(255,255,255,0.05); height:8px; border-radius:4px; overflow:hidden;">
                            <div style="background:var(--accent-gold); width:@timeElapsedPct%; height:100%;"></div>
                        </div>
                        <div style="font-size:0.7rem; color:var(--text-secondary); margin-top:3px;">Geçen: @elapsedDaysRep gün / Toplam: @totalProjDaysRep gün</div>
                    </div>

                    <!-- İş İlerlemesi -->
                    <div>
                        <div style="display:flex; justify-content:space-between; font-size:0.8rem; font-weight:600; margin-bottom:5px;">
                            <span>🚀 Proje İlerleme (Tamamlanma)</span>
                            <span style="color:var(--accent-emerald);">@project.Progress%</span>
                        </div>
                        <div style="background:rgba(255,255,255,0.05); height:8px; border-radius:4px; overflow:hidden;">
                            <div style="background:var(--accent-emerald); width:@project.Progress%; height:100%;"></div>
                        </div>
                    </div>

                    <!-- Kritik Görev Tamamlanma -->
                    <div>
                        <div style="display:flex; justify-content:space-between; font-size:0.8rem; font-weight:600; margin-bottom:5px;">
                            <span>⚡ Kritik Yol Tamamlanma</span>
                            <span style="color:#f87171;">@criticalPctRep.ToString("N0")%</span>
                        </div>
                        <div style="background:rgba(255,255,255,0.05); height:8px; border-radius:4px; overflow:hidden;">
                            <div style="background:#ef4444; width:@criticalPctRep%; height:100%;"></div>
                        </div>
                        <div style="font-size:0.7rem; color:var(--text-secondary); margin-top:3px;">@completedCriticalRep / @criticalTasksRep kritik görev tamamlandı</div>
                    </div>

                    <!-- Bütçe Kullanımı -->
                    <div>
                        <div style="display:flex; justify-content:space-between; font-size:0.8rem; font-weight:600; margin-bottom:5px;">
                            <span>💰 Bütçe Kullanımı</span>
                            <span style="color:@(budgetUsagePercent > 90 ? "#ef4444" : "var(--accent-gold)");">@budgetUsagePercent.ToString("N1")%</span>
                        </div>
                        <div style="background:rgba(255,255,255,0.05); height:8px; border-radius:4px; overflow:hidden;">
                            <div style="background:@(budgetUsagePercent > 90 ? "#ef4444" : "var(--accent-gold)"); width:@(budgetUsagePercent > 100 ? 100 : budgetUsagePercent)%; height:100%;"></div>
                        </div>
                        <div style="font-size:0.7rem; color:var(--text-secondary); margin-top:3px;">@totalExpenses.ToString("N0") TL / @project.Budget.ToString("N0") TL öngörülen bütçe</div>
                    </div>

                    <!-- SPI / CPI -->
                    <div style="border-top:1px solid var(--border-color); padding-top:14px; display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                        <div style="background:rgba(16,185,129,0.07); border:1px solid rgba(16,185,129,0.15); border-radius:8px; padding:12px; text-align:center;">
                            <div style="font-size:0.65rem; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-secondary); margin-bottom:4px;">SPI (Zaman Endeksi)</div>
                            <div style="font-size:1.4rem; font-weight:800; color:@(spi >= 1 ? "var(--accent-emerald)" : "#f59e0b");">@spi.ToString("F2")</div>
                            <div style="font-size:0.65rem; color:var(--text-muted); margin-top:2px;">@(spi >= 1 ? "Takvim önde" : spi >= 0.85 ? "Hafif geride" : "Kritik gecikme")</div>
                        </div>
                        <div style="background:rgba(245,158,11,0.07); border:1px solid rgba(245,158,11,0.15); border-radius:8px; padding:12px; text-align:center;">
                            <div style="font-size:0.65rem; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-secondary); margin-bottom:4px;">CPI (Maliyet Endeksi)</div>
                            <div style="font-size:1.4rem; font-weight:800; color:@(cpi >= 1 ? "var(--accent-emerald)" : "#ef4444");">@cpi.ToString("F2")</div>
                            <div style="font-size:0.65rem; color:var(--text-muted); margin-top:2px;">@(cpi >= 1 ? "Bütçe altında" : "Bütçe aşımı riski")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ─── SATIR 2: EKİP MAAŞ MALİYET ANALİZİ + KASA HAREKETLERİ TARİHÇESİ ─── -->
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-bottom:20px;">

            <!-- EKİP MAAŞ MALİYET ANALİZİ -->
            <div class="db-glass-panel" style="padding:22px;">
                <h3 class="premium-card-title">👥 Ekip Maaş & İşçilik Maliyet Raporu</h3>
                <div style="margin-top:16px;">
                    <div class="premium-table-container" style="margin-top:0;">
                        <table class="premium-table">
                            <thead>
                                <tr>
                                    <th>Üye</th>
                                    <th>Rol</th>
                                    <th style="text-align:right;">Günlük (TL)</th>
                                    <th style="text-align:right;">Görev Günü</th>
                                    <th style="text-align:right;">Toplam Maliyet</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var grandPayroll = 0.0;
                                }
                                @foreach (var m in Model.Team)
                                {
                                    var mDays = Model.Tasks.Where(t => t.AssigneeId == m.Id).Sum(t => t.DurationDays);
                                    var mCost = mDays * m.DailySalary;
                                    grandPayroll += mCost;
                                    <tr>
                                        <td><span style="margin-right:6px;">@m.Avatar</span>@m.Name</td>
                                        <td style="font-size:0.75rem; color:var(--accent-gold);">@m.Role</td>
                                        <td style="text-align:right; font-weight:600; color:var(--text-primary);">@m.DailySalary.ToString("N0")</td>
                                        <td style="text-align:right; color:var(--text-secondary);">@mDays gün</td>
                                        <td style="text-align:right; font-weight:700; color:@(mCost > 100000 ? "#f59e0b" : "var(--accent-emerald)");">@mCost.ToString("N0") TL</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr style="background:rgba(16,185,129,0.06); border-top:2px solid var(--border-color);">
                                    <td colspan="4" style="font-weight:700; color:var(--accent-gold); font-size:0.85rem;">TOPLAM İŞÇİLİK MALİYETİ</td>
                                    <td style="text-align:right; font-weight:800; color:var(--accent-gold); font-size:1rem;">@grandPayroll.ToString("N0") TL</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div style="margin-top:12px; padding:10px 14px; background:rgba(245,158,11,0.06); border:1px solid rgba(245,158,11,0.15); border-radius:8px; font-size:0.75rem; color:var(--accent-gold); line-height:1.5;">
                        ℹ️ İşçilik maliyeti = her üyenin <strong>günlük maaşı × atanan görevlerin toplam süresi</strong> formülüyle hesaplanmıştır. Bu maliyet bütçe kalemlerine <em>ayrıca</em> dahil edilmelidir.
                    </div>
                </div>
            </div>

            <!-- KASA HAREKETLERİ KRONOLOJİK GRAFİK -->
            <div class="db-glass-panel" style="padding:22px;">
                <h3 class="premium-card-title">📈 Kasa Hareketleri Kronolojik Akışı</h3>
                <div style="margin-top:16px; display:flex; flex-direction:column; gap:8px; max-height:360px; overflow-y:auto; padding-right:4px;">
                    @{
                        var runningBalance = 0.0;
                        var allTxSorted = Model.Transactions.OrderBy(t => t.Date).ToList();
                    }
                    @foreach (var tx in allTxSorted)
                    {
                        if (tx.Type == "Gelir") { runningBalance += tx.Amount; }
                        else { runningBalance -= tx.Amount; }
                        <div style="display:flex; gap:12px; align-items:flex-start; padding:10px 12px; background:rgba(255,255,255,0.02); border-radius:8px; border-left:3px solid @(tx.Type == "Gelir" ? "var(--accent-emerald)" : "#ef4444");">
                            <div style="flex-shrink:0; text-align:center; min-width:48px;">
                                <div style="font-size:0.65rem; color:var(--text-muted); font-weight:600;">@tx.Date.ToString("dd MMM")</div>
                                <div style="font-size:1.2rem;">@(tx.Type == "Gelir" ? "💵" : "📤")</div>
                            </div>
                            <div style="flex:1; min-width:0;">
                                <div style="font-size:0.78rem; font-weight:600; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@tx.Description</div>
                                <div style="font-size:0.7rem; color:var(--text-secondary); margin-top:1px;">@tx.Category</div>
                            </div>
                            <div style="flex-shrink:0; text-align:right;">
                                <div style="font-size:0.82rem; font-weight:800; color:@(tx.Type == "Gelir" ? "var(--accent-emerald)" : "#ef4444");">
                                    @(tx.Type == "Gelir" ? "+" : "-")@tx.Amount.ToString("N0") TL
                                </div>
                                <div style="font-size:0.65rem; color:var(--text-muted); margin-top:1px;">Bakiye: @runningBalance.ToString("N0") TL</div>
                            </div>
                        </div>
                    }
                </div>
                <!-- Özet satırı -->
                <div style="margin-top:12px; display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                    <div style="background:rgba(16,185,129,0.07); border:1px solid rgba(16,185,129,0.15); border-radius:8px; padding:10px; text-align:center;">
                        <div style="font-size:0.65rem; text-transform:uppercase; color:var(--text-secondary); letter-spacing:0.8px;">Toplam Gelir İşlemi</div>
                        <div style="font-size:1.1rem; font-weight:800; color:var(--accent-emerald); margin-top:4px;">@Model.Transactions.Count(t => t.Type == "Gelir") adet</div>
                    </div>
                    <div style="background:rgba(239,68,68,0.07); border:1px solid rgba(239,68,68,0.15); border-radius:8px; padding:10px; text-align:center;">
                        <div style="font-size:0.65rem; text-transform:uppercase; color:var(--text-secondary); letter-spacing:0.8px;">Toplam Gider İşlemi</div>
                        <div style="font-size:1.1rem; font-weight:800; color:#ef4444; margin-top:4px;">@Model.Transactions.Count(t => t.Type == "Gider") adet</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ─── SATIR 3: KAPSAMLI YÖNETİCİ RAPORU ─── -->
        <div class="db-glass-panel" style="padding:24px;">
            <h3 class="premium-card-title">📋 Kapsamlı Yönetici & Akademik Raporu</h3>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:18px;">
                <!-- Sol: Proje Durumu Metni -->
                <div style="font-size:0.83rem; line-height:1.75; color:var(--text-secondary); display:flex; flex-direction:column; gap:14px;">
                    <div style="background:rgba(16,185,129,0.05); border:1px solid rgba(16,185,129,0.12); border-radius:8px; padding:14px;">
                        <strong style="color:var(--accent-emerald);">🚀 Proje Genel Durumu</strong><br/>
                        <strong>@project.Name</strong> projesi <strong>@project.StartDate.ToString("dd.MM.yyyy")</strong> tarihinde başlamış olup <strong>@project.EndDate.ToString("dd.MM.yyyy")</strong> tarihinde tamamlanması hedeflenmektedir.
                        Bugün itibarıyla proje <strong style="color:var(--accent-emerald);">%@project.Progress</strong> oranında tamamlanmıştır.
                        Takvime göre geçen süre <strong>@timeElapsedPct.ToString("N0")%</strong> olduğundan,
                        @if (spi >= 1) { <span>proje <strong style="color:var(--accent-emerald);">takvim önündedir</strong>.</span> }
                        else { <span>proje <strong style="color:#f59e0b;">takvim gerisindedir</strong>; aksiyona ihtiyaç duyulmaktadır.</span> }
                    </div>
                    <div style="background:rgba(245,158,11,0.05); border:1px solid rgba(245,158,11,0.12); border-radius:8px; padding:14px;">
                        <strong style="color:var(--accent-gold);">⚡ Kritik Yol (CPM) Analizi</strong><br/>
                        CPM hesaplamasına göre projenin en kısa tamamlanma süresi <strong>@projectDuration gün</strong>dır. Toplam <strong>@criticalTasksRep kritik görevden @completedCriticalRep tanesi</strong> tamamlanmıştır.
                        @{ var remainingCritical = criticalTasksRep - completedCriticalRep; }
                        <strong>@remainingCritical</strong> kritik görev hâlâ devam etmektedir — bu görevlerdeki her gecikme bitiş tarihini doğrudan etkiler.
                    </div>
                </div>
                <!-- Sağ: Finansal Özet -->
                <div style="display:flex; flex-direction:column; gap:10px;">
                    <strong style="color:var(--accent-gold); font-size:0.8rem; text-transform:uppercase; letter-spacing:0.8px;">💼 Finansal Özet Tablosu</strong>
                    @{
                        var finRows = new[] {
                            new { Label="Öngörülen Proje Bütçesi", Value=project.Budget.ToString("N0")+" TL", Color="var(--text-primary)" },
                            new { Label="Toplam Sermaye / Gelir", Value=totalIncomes.ToString("N0")+" TL", Color="var(--accent-emerald)" },
                            new { Label="Gerçekleşen Harcamalar", Value=totalExpenses.ToString("N0")+" TL", Color="#ef4444" },
                            new { Label="Net Kasa Bakiyesi", Value=currentBalance.ToString("N0")+" TL", Color=currentBalance>=0?"var(--accent-emerald)":"#ef4444" },
                            new { Label="Kalan Bütçe Marjı", Value=remainingBudget.ToString("N0")+" TL", Color=remainingBudget>=0?"var(--accent-emerald)":"#f59e0b" },
                            new { Label="Tahmini İşçilik Maliyeti", Value=grandPayroll.ToString("N0")+" TL", Color="var(--accent-gold)" },
                            new { Label="Bütçe Kullanım Oranı", Value=budgetUsagePercent.ToString("N1")+"%", Color=budgetUsagePercent>90?"#ef4444":"var(--accent-gold)" },
                        };
                    }
                    @foreach (var row in finRows)
                    {
                        <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:rgba(255,255,255,0.02); border-radius:6px; border-left:2px solid var(--border-color);">
                            <span style="font-size:0.8rem; color:var(--text-secondary);">@row.Label</span>
                            <strong style="font-size:0.85rem; color:@row.Color;">@row.Value</strong>
                        </div>
                    }

                    <!-- Akademik Not -->
                    <div style="margin-top:6px; background:rgba(59,130,246,0.07); border:1px solid rgba(59,130,246,0.2); border-radius:8px; padding:12px; font-size:0.75rem; color:#93c5fd; line-height:1.55;">
                        📚 <strong>Akademik Not:</strong> SPI=@spi.ToString("F2") (@(spi>=1?"takvimde önde":"geride")), CPI=@cpi.ToString("F2") (@(cpi>=1?"bütçe altında":"risk altında")).
                        Girişimcilik perspektifinden: bütçe sapması @budgetDeviation.ToString("N0") TL (@(budgetDeviation<=0?"tasarruf":"aşım")).
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- MODALS -->
<!-- 1. EDIT PROJECT META MODAL -->
<div class="pm-modal" id="modal-project-meta">
    <div class="pm-modal-content">
        <div class="db-modal-header">
            <span>✏️ Proje Detaylarını Düzenle</span>
            <button onclick="closeModal('modal-project-meta')" style="background:transparent; border:none; color:var(--db-text-muted); cursor:pointer; font-size:1.2rem;">✕</button>
        </div>
        <form asp-action="UpdateProject" method="post">
            <div class="db-modal-body">
                <div class="db-input-group">
                    <label class="premium-form-label">Proje Adı *</label>
                    <input type="text" name="name" class="db-input premium-input" value="@project.Name" required />
                </div>
                <div class="db-input-group">
                    <label class="premium-form-label">Proje Öngörülen Bütçe (TL) *</label>
                    <input type="number" name="budget" step="0.01" class="db-input premium-input" value="@project.Budget" required />
                </div>
                <div class="db-input-group">
                    <label class="premium-form-label">Toplam Kasa Sermayesi (TL) *</label>
                    <input type="number" name="capital" step="0.01" class="db-input premium-input" value="@project.Capital" required />
                </div>
                <div class="db-input-group">
                    <label class="premium-form-label">Statü *</label>
                    <select name="status" class="db-input premium-input">
                        <option value="Planlandı" selected="@(project.Status == "Planlandı")">Planlandı</option>
                        <option value="Devam Ediyor" selected="@(project.Status == "Devam Ediyor")">Devam Ediyor</option>
                        <option value="Tamamlandı" selected="@(project.Status == "Tamamlandı")">Tamamlandı</option>
                    </select>
                </div>
                <div class="db-input-group">
                    <label class="premium-form-label">Proje Açıklaması</label>
                    <textarea name="description" class="db-input premium-input db-input-textarea">@project.Description</textarea>
                </div>
            </div>
            <div class="db-modal-footer">
                <button type="button" class="btn-db btn-db-ghost" onclick="closeModal('modal-project-meta')">İptal</button>
                <button type="submit" class="btn-db btn-db-emerald">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- 2. ADD TASK MODAL -->
<div class="pm-modal" id="modal-add-task">
    <div class="pm-modal-content">
        <div class="db-modal-header">
            <span>➕ Yeni Görev Ekle</span>
            <button onclick="closeModal('modal-add-task')" style="background:transparent; border:none; color:var(--db-text-muted); cursor:pointer; font-size:1.2rem;">✕</button>
        </div>
        <form asp-action="AddTask" method="post">
            <div class="db-modal-body">
                <div class="db-input-group">
                    <label class="premium-form-label">Görev Adı *</label>
                    <input type="text" name="taskName" class="db-input premium-input" placeholder="Örn: Altyapı kablolama montajı" required />
                </div>
                <div class="db-input-group">
                    <label class="premium-form-label">Sorumlu Ekip Üyesi</label>
                    <select name="assigneeId" class="db-input premium-input">
                        <option value="">Atanmadı</option>
                        @foreach (var m in Model.Team)
                        {
                            <option value="@m.Id">@m.Name (@m.Role)</option>
                        }
                    </select>
                </div>
                <div class="db-input-group">
                    <label class="premium-form-label">Süre (Gün) *</label>
                    <input type="number" name="durationDays" min="1" class="db-input premium-input" placeholder="Örn: 7" required />
                </div>
                <div class="db-input-group">
                    <label class="premium-form-label">İlerleme Oranı (%) *</label>
                    <input type="number" name="progressPercent" min="0" max="100" class="db-input premium-input" value="0" required />
                </div>
                <div class="db-input-group">
                    <label class="premium-form-label">Öncül Görevler (Virgülle ayırarak ID'leri girin)</label>
                    <input type="text" name="predecessors" class="db-input premium-input" placeholder="Örn: 1, 2" />
                    <span style="font-size:0.7rem; color:var(--text-secondary);">Mevcut görevlerin IDsini girmek, aralarında bağımlılık oluşturur (örn: Görev 5 başlamak için Görev 3 ve 4'e bağımlı ise: 3,4 girin).</span>
                </div>
            </div>
            <div class="db-modal-footer">
                <button type="button" class="btn-db btn-db-ghost" onclick="closeModal('modal-add-task')">İptal</button>
                <button type="submit" class="btn-db btn-db-emerald">Ekle</button>
            </div>
        </form>
    </div>
</div>

<script>
    function switchTab(tabId) {
        document.querySelectorAll('.pm-section').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.pm-tab-btn').forEach(btn => btn.classList.remove('active'));
        
        const targetSec = document.getElementById('sec-' + tabId);
        if (targetSec) targetSec.classList.add('active');
        
        const activeBtn = document.getElementById('tab-btn-' + tabId);
        if (activeBtn) activeBtn.classList.add('active');
    }

    function toggleGanttView(viewMode) {
        const btnTask = document.querySelector('[onclick="toggleGanttView(\'task\')"]');
        const btnTeam = document.querySelector('[onclick="toggleGanttView(\'team\')"]');
        const taskView = document.getElementById('gantt-task-view');
        const teamView = document.getElementById('gantt-team-view');

        if (viewMode === 'task') {
            taskView.style.display = 'grid';
            teamView.style.display = 'none';
            btnTask.className = 'btn-db btn-db-sm btn-db-emerald';
            btnTeam.className = 'btn-db btn-db-sm btn-db-ghost';
        } else {
            taskView.style.display = 'none';
            teamView.style.display = 'grid';
            btnTask.className = 'btn-db btn-db-sm btn-db-ghost';
            btnTeam.className = 'btn-db btn-db-sm btn-db-emerald';
        }
    }

    function openModal(id) {
        document.getElementById(id).classList.add('open');
    }

    function closeModal(id) {
        document.getElementById(id).classList.remove('open');
    }
</script>
